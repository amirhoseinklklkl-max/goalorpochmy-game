<?xml version='1.0' encoding='utf-8'?>
<widget id="ir.amir.goalpoch" version="2" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/20">
    <name>گل یا پوچ</name>
    <description>My awesome game</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="*" />
    <preference name="android-minSdkVersion" value="14" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="MixedContentMode" value="0" />
    <preference name="Fullscreen" value="true" />
    <icon src="images/profile-sheet0.png" />
    <icon src="images/profile-sheet0.png" density="ldpi" />
    <icon src="images/profile-sheet0.png" density="mdpi" />
    <icon src="images/profile-sheet0.png" density="hdpi" />
    <icon src="images/profile-sheet0.png" density="xhdpi" />
    <icon src="images/profile-sheet0.png" density="xxhdpi" />
    <icon src="images/profile-sheet0.png" density="xxxhdpi" />
    <platform name="android">
        <allow-intent href="market:*" />
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
            <activity android:windowSoftInputMode="adjustPan" />
        </config-file>
    </platform>
</widget>
