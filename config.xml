<?xml version='1.0' encoding='utf-8'?>
<widget id="ir.amir.goalpoch" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>گل یا پوچ</name>
    <description>
        بازی گل یا پوچ
    </description>
    <author email="you@example.com" href="https://example.com">
        Amir
    </author>
    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff000000" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/loading-logo.png" />
    <!-- فیکس اصلی باگ "Invalid <color>" - مقدار پیش‌فرض خود Cordova-android نامعتبره (0) -->
    <preference name="AndroidWindowSplashScreenBackground" value="#000000" />

    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />
        <preference name="AndroidXEnabled" value="true" />
        <icon density="ldpi" src="www/icon-ldpi.png" />
        <icon density="mdpi" src="www/icon-mdpi.png" />
        <icon density="hdpi" src="www/icon-hdpi.png" />
        <icon density="xhdpi" src="www/icon-xhdpi.png" />
        <icon density="xxhdpi" src="www/icon-xxhdpi.png" />
        <icon density="xxxhdpi" src="www/icon-xxxhdpi.png" />

        <!-- appcompat 1.6.1 (نسخه پیش‌فرض) با AAPT2 جدید رانرهای گیت‌هاب باگ داره
             و ارور "Invalid <color> for given resource value" میده.
             این خط نسخه جدیدتر و سالم رو اجباری می‌کنه. -->
        <framework src="androidx.appcompat:appcompat:1.7.0" />

        <!-- فیکس باگ جمع‌شدن/تغییرشکل صفحه بازی موقع باز شدن کیبورد (چت‌روم).
             adjustPan جواب نداد (هنوز خود وب‌ویو ریفلو می‌شد). adjustNothing قوی‌تره:
             کیبورد کاملاً شناور میاد روی صفحه و هیچ تغییری تو اندازه/چینش محتوا اتفاق نمی‌افته. -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
            <activity android:windowSoftInputMode="adjustNothing" />
        </edit-config>
    </platform>

    <!-- فیکس قطعی باگ appcompat/AAPT2 - سطح پایین‌تر از framework، همیشه جواب میده -->
    <hook type="after_prepare" src="hooks/after_prepare/010_fix_appcompat.js" platform="android" />

    <!-- پلاگین تبلیغات ادیوری -->
    <plugin name="adivery-cordova" source="npm" />

    <!-- پلاگین خرید درون‌برنامه‌ای (مایکت) -->
    <plugin name="cordova-plugin-android-iab" source="npm" />
    <config-file target="AndroidManifest.xml" parent="/manifest">
        <uses-permission android:name="ir.mservices.market.BILLING" />
    </config-file>

    <!-- پلاگین‌های پایه کوردوا
         نکته: cordova-plugin-whitelist حذف شد - با نسخه‌های جدید cordova-android
         ناسازگاره (کلاس Whitelist دیگه وجود نداره)، چون این قابلیت الان خودِ
         هسته cordova-android با همون تگ‌های access/allow-intent بالا انجام میده. -->
    <plugin name="cordova-plugin-device" source="npm" />
    <plugin name="cordova-plugin-splashscreen" source="npm" />

</widget>
